# Legal Metrology Inspection System - Configuration
PROJECT_NAME="Legal Metrology Packaged-Commodity Inspection System"
ENVIRONMENT=development
DEBUG=True

# Database Configuration — Neon PostgreSQL ONLY. SQLite is NOT supported.
# Replace with your actual Neon PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# Test Database — REQUIRED for running automated tests.
# Must point to a SEPARATE PostgreSQL database from the production DATABASE_URL.
# Obtain a test database from Neon (free tier supports multiple databases).
# Tests FAIL FAST if this is missing, is a SQLite URL, or equals DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname_test?sslmode=require&channel_binding=require

# JWT & Security
SECRET_KEY=dev_secret_key_change_in_production_sih2026_doca_legal_metrology
