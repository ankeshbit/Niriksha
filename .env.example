# Legal Metrology Inspection System - Configuration
PROJECT_NAME="Legal Metrology Packaged-Commodity Inspection System"
ENVIRONMENT=development
DEBUG=True

# Database Configuration — Neon PostgreSQL ONLY. SQLite is NOT supported.
# Replace with your actual Neon PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# Test Database — REQUIRED for running automated tests.
# Must point to a SEPARATE PostgreSQL database from the production DATABASE_URL.
# Obtain a test database from Neon (free tier supports multiple databases).
# Tests FAIL FAST if this is missing, is a SQLite URL, or equals DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname_test?sslmode=require&channel_binding=require

# JWT & Security
SECRET_KEY=dev_secret_key_change_in_production_sih2026_doca_legal_metrology
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Development Seed Officer Credentials (Local Demo Only)
SEED_OFFICER_ID=DOCA-INSP-842
SEED_OFFICER_PASSWORD=admin123
SEED_OFFICER_NAME=Rajesh Sharma
SEED_OFFICER_DESIGNATION=Inspector (Legal Metrology)
SEED_OFFICER_ZONE=Northern Zone - Delhi HQ

# Storage paths
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports

# =============================================================================
# Supabase Integration (PostgreSQL + Storage)
# =============================================================================
# To connect to Supabase, provide these values.
# Leave SUPABASE_URL blank if not using Supabase Storage.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://thrafkbndiupiyynevzy.supabase.co

# Supabase Service Role Key (Backend ONLY — NEVER put in mobile app)
SUPABASE_KEY=sb_publishable_CjVSemE3zmkRdwiI1CGHwQ_pIn298aO

# Supabase PostgreSQL Connection String
# Transaction Pooler (port 6543) is recommended for web/API services:
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Direct Connection (port 5432) for migrations:
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Storage Buckets (create these in Supabase Dashboard > Storage before using)
SUPABASE_BUCKET_IMAGES=inspection-images
