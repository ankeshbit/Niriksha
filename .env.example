# Legal Metrology Inspection System - Configuration
PROJECT_NAME="Legal Metrology Packaged-Commodity Inspection System"
ENVIRONMENT=development
DEBUG=True

# Database Configuration — Neon PostgreSQL ONLY. SQLite is NOT supported.
# Replace with your actual Neon PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# Test Database — REQUIRED for running automated tests.
# Must point to a SEPARATE PostgreSQL database from the production DATABASE_URL.
# Obtain a test database from Neon (free tier supports multiple databases).
# Tests FAIL FAST if this is missing, is a SQLite URL, or equals DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname_test?sslmode=require&channel_binding=require

# JWT & Security — REQUIRED
# Must be set to a secure, randomly generated string (generate via: openssl rand -hex 32)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
# Comma-separated list of allowed browser origins (e.g. https://admin.example.com).
# Defaults to blank (no origins). In production, wildcard '*' is forbidden.
# Note: Native mobile apps (Android APK) are not subject to CORS restrictions.
CORS_ORIGINS=

# Development Seed Officer Credentials (Local Demo Only)
# In production (ENVIRONMENT=production), SEED_OFFICER_PASSWORD is required.
SEED_OFFICER_ID=DOCA-INSP-842
SEED_OFFICER_PASSWORD=admin123
SEED_OFFICER_NAME=Rajesh Sharma
SEED_OFFICER_DESIGNATION=Inspector (Legal Metrology)
SEED_OFFICER_ZONE=Northern Zone - Delhi HQ

# Supervisor Account Credentials (Required for seeding Supervisor role)
# In production (ENVIRONMENT=production), SEED_SUPERVISOR_PASSWORD is required.
SEED_SUPERVISOR_ID=DOCA-SUP-101
SEED_SUPERVISOR_NAME=NiriKsha Supervisor
SEED_SUPERVISOR_DESIGNATION=Supervisory Officer (Legal Metrology)
SEED_SUPERVISOR_ZONE=Central HQ
SEED_SUPERVISOR_PASSWORD=admin123

# Admin Account Credentials (Required for seeding Admin role)
# In production (ENVIRONMENT=production), SEED_ADMIN_PASSWORD is required.
SEED_ADMIN_ID=DOCA-ADMIN-001
SEED_ADMIN_NAME=Director Vikram Malhotra
SEED_ADMIN_DESIGNATION=Director of Legal Metrology (Admin)
