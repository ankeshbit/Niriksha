{
  "expo": {
    "name": "Legal Metrology Field Inspect",
    "slug": "legal-metrology-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#031635"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.doca.legalmetrology"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031635"
      },
      "package": "gov.doca.legalmetrology"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Legal Metrology app to access camera for capturing package label images."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Legal Metrology app to access gallery for selecting package images."
        }
      ]
    ]
  }
}
